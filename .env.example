# Environment
ENVIRONMENT=simulation  # simulation | testnet | production (NOT ALLOWED)

# Binance Testnet (optional - only for testnet mode)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Database
DATABASE_URL=sqlite:///data/market_maker.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/market_maker

# Redis (optional, for distributed training)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Training
RAY_ADDRESS=auto
RAY_NUM_CPUS=4
RAY_NUM_GPUS=0

# Symbol
SYMBOL=BTCUSDT